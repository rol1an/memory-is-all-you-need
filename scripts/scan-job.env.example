# 复制为 scripts/scan-job.env 并填入你自己的值（该文件已被 .gitignore 忽略，不会入库）

# launchd 的环境是干净的，需要显式给出含 node 的 PATH
export PATH="$HOME/.nvm/versions/node/v20.20.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

# —— 飞书扫描器（npm run scan:feishu）——
# OpenAI 兼容的 /chat/completions 网关。担心消息内容出网就指向私有部署
export LENS_LLM_URL="https://your-gateway.example.com/v1/chat/completions"
export LENS_LLM_MODEL="your-model"
export LENS_LLM_KEY="sk-..."
# 网关需要附加动态凭证时（如短时 JWT）：header 名 + 打印其值的命令
#export LENS_LLM_EXTRA_HEADER="X-Some-Token"
#export LENS_LLM_EXTRA_HEADER_CMD="your-cli auth print-token"
# 飞书候选写入的记忆桶（~/.claude/projects/ 下的目录名）
export LENS_SCAN_BUCKET="-Users-you-somewhere"
# 起草 prompt 里对你的称呼，帮模型理解视角（如"张三（软件工程师）"）
#export LENS_SCAN_PERSONA="用户"

# —— 审核卡片（npx tsx src/server/notify-card.ts）——
# 缺省按群名「记忆观测台」搜索；也可直接钉死 chat_id
#export LENS_NOTIFY_CHAT="oc_..."
